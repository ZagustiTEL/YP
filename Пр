// =============================================
// Стул с двумя ножками и поперечными палками
// =============================================

#version 3.7;
global_settings { assumed_gamma 1.0 }

// Камера
camera {
  location  <1.5, 1.2, -2.5>
  look_at   <0, 0.6, 0>
  angle 45
}

// Источник света
light_source {
  <2, 5, -3>
  color rgb <1, 1, 1>
}
light_source {
  <-1, 3, -2>
  color rgb <0.6, 0.6, 0.6>
}

// Пол (необязательно)
plane { y, -0.05 pigment { color rgb <0.9, 0.85, 0.8> } }

// -----------------------------
// Параметры стула
#declare LegHeight   = 0.85;
#declare LegWidth    = 0.05;
#declare LegDepth    = 0.05;
#declare LegSpacing  = 0.45;   // расстояние между ножками

#declare SeatThick   = 0.04;
#declare SeatWidth   = LegSpacing + LegWidth;
#declare SeatDepth   = 0.40;
#declare SeatHeight  = 0.45;   // высота сиденья от пола

#declare BackHeight  = 0.40;   // высота спинки
#declare BackThick   = 0.03;

// Поперечные палки (между ножками)
#declare BarRadius   = 0.025;
#declare BarY_Seat   = SeatHeight;            // под сиденье
#declare BarY_Back   = SeatHeight + BackHeight; // под спинку

// -----------------------------
// Левая ножка
#declare LeftLeg = box {
  <-LegSpacing/2 - LegWidth, 0, -LegDepth/2>,
  <-LegSpacing/2, LegHeight, LegDepth/2>
  pigment { color rgb <0.6, 0.4, 0.2> }
  finish  { phong 0.6 }
}

// Правая ножка
#declare RightLeg = box {
  < LegSpacing/2, 0, -LegDepth/2>,
  < LegSpacing/2 + LegWidth, LegHeight, LegDepth/2>
  pigment { color rgb <0.6, 0.4, 0.2> }
  finish  { phong 0.6 }
}

// Поперечная палка (нижняя — под сиденье)
#declare BarSeat = cylinder {
  <-LegSpacing/2, BarY_Seat, 0>,
  < LegSpacing/2, BarY_Seat, 0>,
  BarRadius
  pigment { color rgb <0.7, 0.5, 0.25> }
  finish  { phong 0.7 }
}

// Поперечная палка (верхняя — под спинку)
#declare BarBack = cylinder {
  <-LegSpacing/2, BarY_Back, 0>,
  < LegSpacing/2, BarY_Back, 0>,
  BarRadius
  pigment { color rgb <0.7, 0.5, 0.25> }
  finish  { phong 0.7 }
}

// Сиденье (лежит на нижней палке)
#declare Seat = box {
  < -SeatWidth/2, BarY_Seat, -SeatDepth/2 >,
  <  SeatWidth/2, BarY_Seat + SeatThick, SeatDepth/2 >
  pigment { color rgb <0.55, 0.35, 0.15> }
  finish  { phong 0.5 }
}

// Спинка (крепится к верхней палке)
#declare Back = box {
  < -SeatWidth/2 + 0.03, BarY_Back, -0.02 >,
  <  SeatWidth/2 - 0.03, BarY_Back + BackHeight, 0.04 >
  pigment { color rgb <0.55, 0.35, 0.15> }
  finish  { phong 0.5 }
}

// -----------------------------
// Сборка
object { LeftLeg  }
object { RightLeg }
object { BarSeat }
object { BarBack }
object { Seat    }
object { Back    }
