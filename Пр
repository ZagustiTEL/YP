// Школьный стул для POV-Ray
// Простой, прочный, с прямыми углами

#version 3.7;
global_settings { assumed_gamma 1.0 }

#include "colors.inc"

camera {
  orthographic
  location <2, 1.5, -3>
  look_at <0.5, 0.6, 0>
  right x * image_width / image_height
  angle 35
}

light_source {
  <2, 5, -3>
  color White
}
light_source {
  <-1, 3, -2>
  color Gray70
}
light_source {
  <0, 2, 4>
  color Gray50
}

sky_sphere { pigment { color rgb <0.7, 0.8, 1.0> } }

// Материал дерева
#declare WoodMaterial = material {
  texture {
    pigment { color rgb <0.75, 0.55, 0.35> }
    finish { phong 0.4 reflection 0.05 }
    normal { bumps 0.2 scale 0.05 }
  }
}

#declare MetalMaterial = material {
  texture {
    pigment { color rgb <0.3, 0.3, 0.35> }
    finish { phong 0.6 metallic }
  }
}

// ---- СИДЕНЬЕ ----
box {
  <-0.5, 0.55, -0.45>, <0.5, 0.6, 0.45>
  material { WoodMaterial }
}

// ---- СПИНКА ----
box {
  <-0.45, 0.6, -0.48>, <0.45, 1.0, -0.42>
  material { WoodMaterial }
}
// Дополнительная рейка спинки (поперечная)
box {
  <-0.48, 0.75, -0.49>, <0.48, 0.78, -0.41>
  material { WoodMaterial }
}

// ---- НОЖКИ (4 штуки) ----
// Передняя левая
box {
  <-0.45, 0.0, -0.4>, <-0.35, 0.55, -0.3>
  material { MetalMaterial }
}
// Передняя правая
box {
  <0.35, 0.0, -0.4>, <0.45, 0.55, -0.3>
  material { MetalMaterial }
}
// Задняя левая
box {
  <-0.45, 0.0, 0.3>, <-0.35, 0.55, 0.4>
  material { MetalMaterial }
}
// Задняя правая
box {
  <0.35, 0.0, 0.3>, <0.45, 0.55, 0.4>
  material { MetalMaterial }
}

// Поперечные перекладины между ножками (для жесткости)
// Передняя
box {
  <-0.45, 0.25, -0.4>, <0.45, 0.28, -0.3>
  material { MetalMaterial }
}
// Задняя
box {
  <-0.45, 0.25, 0.3>, <0.45, 0.28, 0.4>
  material { MetalMaterial }
}
// Боковые (левая и правая)
box {
  <-0.45, 0.25, -0.4>, <-0.35, 0.28, 0.4>
  material { MetalMaterial }
}
box {
  <0.35, 0.25, -0.4>, <0.45, 0.28, 0.4>
  material { MetalMaterial }
}

// Пол (просто для референса)
plane {
  y, -0.05
  pigment { color rgb <0.85, 0.8, 0.75> }
  finish { ambient 0.2 diffuse 0.7 }
}
